{
  "name": "interview-assistant-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "build": "vue-tsc -b && vite build",
    "build:mock": "vue-tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "1.53.0",
    "@tanstack/vue-query": "5.104.1",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "pretendard": "1.3.9",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.43",
    "vue-chartjs": "5.3.4",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
