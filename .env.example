# Copy to .env. All app settings use the IA_ prefix.
IA_DATABASE_URL=sqlite+pysqlite:///./dev.db
IA_PROVIDERS_FILE=config/providers.yaml
# Local run without credentials:
# IA_PROVIDERS_FILE=config/providers.fake.yaml

# De-identification settings (token formats, dictionaries, detectors).
IA_DEID_FILE=config/deid.yaml
# Fernet key for encrypted columns (candidate identity, de-identification reverse map).
# Generate: uv run python -c "from interview_assistant.crypto import FieldCipher as F; print(F.generate_key())"
# Losing it makes stored identities unrecoverable; never commit it.
IA_ENCRYPTION_KEY=

# Raw zone on disk: uploaded application files (and later recordings). Git-ignored, never served.
IA_UPLOADS_DIR=uploads
IA_RECORDINGS_DIR=recordings
# Until SSO: employee number of the interviewer the API treats as signed in (seed: 김서연).
IA_DEV_INTERVIEWER=E24017
# Pace of the simulated candidate in live interviews: 1 = like the frontend mock, 0 = instant.
IA_DEMO_SPEED=1

# GCP (Vertex AI, Speech-to-Text). Leave empty when using the fake providers.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
