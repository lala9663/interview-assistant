# Copy to .env. All app settings use the IA_ prefix.
IA_DATABASE_URL=sqlite+pysqlite:///./dev.db
IA_PROVIDERS_FILE=config/providers.yaml
# Local run without credentials:
# IA_PROVIDERS_FILE=config/providers.fake.yaml

# De-identification settings (token formats, dictionaries, detectors).
IA_DEID_FILE=config/deid.yaml
# Fernet key for encrypted columns (candidate identity, de-identification reverse map).
# Generate: uv run python -c "from interview_assistant.crypto import FieldCipher as F; print(F.generate_key())"
# Losing it makes stored identities unrecoverable; never commit it.
IA_ENCRYPTION_KEY=

# Raw zone on disk: uploaded application files (and later recordings). Git-ignored, never served.
IA_UPLOADS_DIR=uploads
IA_RECORDINGS_DIR=recordings
# Downloaded model weights (local Whisper ...), fetched from the admin screen. Git-ignored.
IA_WEIGHTS_DIR=weights
# Hugging Face mirror or token for those downloads, if the network needs one:
# HF_ENDPOINT=https://huggingface.co
# HF_TOKEN=
# Until SSO: employee number of the interviewer the API treats as signed in (seed: 김서연).
IA_DEV_INTERVIEWER=E24017
# Pace of the simulated candidate in live interviews: 1 = like the frontend mock, 0 = instant.
IA_DEMO_SPEED=1

# Recruiting-site intake (docs/site-intake-spec.md): the shared HMAC key the site signs requests with.
# Empty: the site endpoints answer 503. 32+ random bytes, e.g.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# IA_SITE_SECRET_PREVIOUS is accepted too while the key is being rotated. Never commit them.
IA_SITE_SECRET=
IA_SITE_SECRET_PREVIOUS=
# Background workers applying received events (0: they wait in the queue).
IA_INTAKE_WORKERS=4

# Agent calls through the MCP server (docs/agent-integration.md). How a call proves who is asking:
# dev_token until the agent platform's or SSO's identity is added; its key signs development
# tokens (scripts/agent_token.py <사번>). Empty: agent calls answer 503.
IA_AGENT_IDENTITY=dev_token
IA_AGENT_TOKEN_SECRET=

# MCP server (python -m interview_assistant.agent). Read by the MCP server only, not the API.
# Over HTTP the platform sends each user's token in one of IA_MCP_IDENTITY_HEADERS (JSON list);
# IA_MCP_TOKEN is the one person's token for stdio and is never used over HTTP.
IA_MCP_API_URL=http://127.0.0.1:8000
IA_MCP_WEB_URL=http://localhost:5173
IA_MCP_AGENT_NAME=mcp-local
IA_MCP_IDENTITY_HEADERS=["authorization", "x-ia-token"]
IA_MCP_TOKEN=

# GCP (Vertex AI, Speech-to-Text). Leave empty when using the fake providers.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
